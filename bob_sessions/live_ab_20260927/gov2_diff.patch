+# ---------------------------------------------------------------------------
+# Token-bucket rate limiter (per-IP, in-memory)
+# ---------------------------------------------------------------------------
+
+# Each IP gets a bucket that refills at BUCKET_REFILL_RATE tokens/second and
+# holds at most BUCKET_CAPACITY tokens.  One token is consumed per request.
+# When a bucket is empty the request is rejected with a 429.
+
+BUCKET_CAPACITY: int = 10          # max burst
+BUCKET_REFILL_RATE: float = 1.0    # tokens restored per second
+
+
+class _TokenBucket:
+    """Thread-safe token-bucket for a single identity (e.g. a client IP)."""
+
+    __slots__ = ("_capacity", "_rate", "_tokens", "_last_refill", "_lock")
+
+    def __init__(self, capacity: int, rate: float) -> None:
+        self._capacity = capacity
+        self._rate = rate
+        self._tokens: float = float(capacity)
+        self._last_refill: datetime = datetime.now(timezone.utc)
+        self._lock = threading.Lock()
+
+    def consume(self) -> bool:
+        """Attempt to consume one token.
+
+        Returns:
+            True if the token was consumed (request allowed).
+            False if the bucket is empty (request should be rate-limited).
+        """
+        with self._lock:
+            self._refill()
+            if self._tokens >= 1.0:
+                self._tokens -= 1.0
+                return True
+            return False
+
+    def _refill(self) -> None:
+        now = datetime.now(timezone.utc)
+        elapsed = (now - self._last_refill).total_seconds()
+        self._tokens = min(self._capacity, self._tokens + elapsed * self._rate)
+        self._last_refill = now
+
+
+# Global registry: { identifier: _TokenBucket }
+# Protected by a module-level lock only for bucket *creation*; each bucket
+# uses its own internal lock for token operations.
+_BUCKET_REGISTRY: Dict[str, _TokenBucket] = {}
+_REGISTRY_LOCK = threading.Lock()
+
+
+def check_rate_limit(identifier: str) -> bool:
+    """Return True if the *identifier* is within its rate limit.
+
+    A new bucket (full) is created on first access.  Pass the client IP (or
+    any opaque key) as *identifier*.
+    """
+    with _REGISTRY_LOCK:
+        if identifier not in _BUCKET_REGISTRY:
+            _BUCKET_REGISTRY[identifier] = _TokenBucket(BUCKET_CAPACITY, BUCKET_REFILL_RATE)
+    return _BUCKET_REGISTRY[identifier].consume()
+
+
