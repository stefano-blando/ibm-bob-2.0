diff --git a/demo_app/database/schema.sql b/demo_app/database/schema.sql
index e8b8c86..34f97a1 100644
--- a/demo_app/database/schema.sql
+++ b/demo_app/database/schema.sql
@@ -16,3 +16,14 @@ CREATE TABLE IF NOT EXISTS refresh_tokens (
     expires_at TIMESTAMP NOT NULL,
     FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE CASCADE
 );
+
+-- Audit log of every failed login attempt.
+-- Rows are append-only and must never be deleted or updated.
+CREATE TABLE IF NOT EXISTS failed_logins (
+    id           INTEGER PRIMARY KEY AUTOINCREMENT,
+    email        VARCHAR(255) NOT NULL,
+    attempted_at TIMESTAMP   NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
+
+CREATE INDEX IF NOT EXISTS idx_failed_logins_email
+    ON failed_logins (email);
