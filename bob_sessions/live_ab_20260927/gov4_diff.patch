+# ---------------------------------------------------------------------------
+# Failed-login persistence (requires failed_logins table in schema.sql)
+# ---------------------------------------------------------------------------
+
+def _get_db_path() -> str:
+    return _config.DATABASE_URL.replace("sqlite:///", "")
+
+
+def persist_failed_login(email: str, client_ip: str = "unknown") -> None:
+    """Insert a row into *failed_logins* recording this failed attempt.
+
+    This is a best-effort write: if the table does not yet exist (e.g. schema
+    migration has not been applied) the error is silently swallowed so that it
+    never breaks the authentication flow.
+    """
+    now = datetime.now(timezone.utc).isoformat()
+    try:
+        conn = sqlite3.connect(_get_db_path())
+        try:
+            conn.execute(
+                """
+                INSERT INTO failed_logins (email, client_ip, attempted_at)
+                VALUES (?, ?, ?)
+                """,
+                (email, client_ip, now),
+            )
+            conn.commit()
+        finally:
+            conn.close()
+    except sqlite3.OperationalError:
+        # Table does not exist yet — schema migration pending.
+        pass
