+# ---------------------------------------------------------------------------
+# In-memory token-bucket rate limiter (per IP address)
+# ---------------------------------------------------------------------------
+# Each bucket allows BUCKET_CAPACITY requests, refilling at REFILL_RATE
+# tokens per second.  Once a bucket is empty the request is rejected with 429.
+
+BUCKET_CAPACITY: float = 10.0   # maximum burst size (tokens)
+REFILL_RATE: float = 1.0        # tokens added per second
+
+_buckets: dict[str, "_TokenBucket"] = {}
+_buckets_lock = threading.Lock()
+
+
+class _TokenBucket:
+    """Thread-safe token-bucket for a single client (identified by IP)."""
+
+    __slots__ = ("_tokens", "_last_refill", "_lock")
+
+    def __init__(self) -> None:
+        self._tokens: float = BUCKET_CAPACITY
+        self._last_refill: float = time.monotonic()
+        self._lock = threading.Lock()
+
+    def consume(self, tokens: float = 1.0) -> bool:
+        """Try to consume *tokens* from the bucket.
+
+        Returns True when the request is allowed, False when the bucket is
+        exhausted (caller should respond 429).
+        """
+        with self._lock:
+            now = time.monotonic()
+            elapsed = now - self._last_refill
+            self._tokens = min(
+                BUCKET_CAPACITY, self._tokens + elapsed * REFILL_RATE
+            )
+            self._last_refill = now
+            if self._tokens >= tokens:
+                self._tokens -= tokens
+                return True
+            return False
+
+
+def _get_bucket(client_ip: str) -> "_TokenBucket":
+    """Return (creating if necessary) the bucket for *client_ip*."""
+    with _buckets_lock:
+        bucket = _buckets.get(client_ip)
+        if bucket is None:
+            bucket = _TokenBucket()
+            _buckets[client_ip] = bucket
+        return bucket
+
