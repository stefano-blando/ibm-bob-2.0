 from datetime import datetime, timedelta, timezone
 from typing import Any
 
 import demo_app.core.config as _config
 from demo_app.services.user_service import verify_user
 
+# ---------------------------------------------------------------------------
+# In-memory token-bucket rate limiter
+# ---------------------------------------------------------------------------
+# Each bucket allows a burst of BUCKET_CAPACITY requests, then refills at
+# REFILL_RATE tokens per second.  Keyed by email address.
+# ---------------------------------------------------------------------------
+BUCKET_CAPACITY: int = 5        # maximum tokens (burst size)
+REFILL_RATE: float = 1.0 / 60  # 1 token per 60 seconds
+
+_buckets: dict[str, dict] = {}
+_buckets_lock = threading.Lock()
+
+
+def _consume_token(key: str) -> bool:
+    """Return True if a token was consumed; False if the bucket is empty."""
+    now = datetime.now(timezone.utc).timestamp()
+    with _buckets_lock:
+        if key not in _buckets:
+            _buckets[key] = {"tokens": float(BUCKET_CAPACITY), "last_refill": now}
+        bucket = _buckets[key]
+
+        # Refill proportionally to elapsed time.
+        elapsed = now - bucket["last_refill"]
+        bucket["tokens"] = min(
+            float(BUCKET_CAPACITY),
+            bucket["tokens"] + elapsed * REFILL_RATE,
+        )
+        bucket["last_refill"] = now
+
+        if bucket["tokens"] >= 1.0:
+            bucket["tokens"] -= 1.0
+            return True
+        return False
+
+
 # Maximum consecutive failed attempts before the account is temporarily locked.
