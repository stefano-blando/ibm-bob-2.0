 # Maximum consecutive failed attempts before the account is temporarily locked.
 MAX_FAILED_ATTEMPTS = 5
 # Lock duration in minutes after exceeding MAX_FAILED_ATTEMPTS.
 LOCKOUT_MINUTES = 15
 
+# ---------------------------------------------------------------------------
+# In-memory token-bucket rate limiter
+# ---------------------------------------------------------------------------
+# Each key (email) gets a bucket of BUCKET_CAPACITY tokens that refills at
+# REFILL_RATE tokens-per-second.  Each login attempt consumes one token.
+# When the bucket is empty the request is rejected with HTTP 429.
+
+_BUCKET_CAPACITY: int = 5          # burst: up to 5 attempts in quick succession
+_REFILL_RATE: float = 1 / 60.0    # steady-state: 1 attempt per minute
+
+_buckets: dict[str, dict] = {}     # { email: {"tokens": float, "last_refill": float} }
+_bucket_lock = threading.Lock()
+
+
+def _consume_token(email: str) -> bool:
+    """Try to consume one token for *email*.
+
+    Returns True if a token was available (request allowed), False if the
+    bucket is empty (request should be rate-limited).
+    """
+    import time
+    now = time.monotonic()
+    with _bucket_lock:
+        bucket = _buckets.get(email)
+        if bucket is None:
+            # First request: full bucket, consume one immediately.
+            _buckets[email] = {"tokens": float(_BUCKET_CAPACITY - 1), "last_refill": now}
+            return True
+
+        # Refill tokens proportional to elapsed time since last check.
+        elapsed = now - bucket["last_refill"]
+        bucket["tokens"] = min(
+            float(_BUCKET_CAPACITY),
+            bucket["tokens"] + elapsed * _REFILL_RATE,
+        )
+        bucket["last_refill"] = now
+
+        if bucket["tokens"] >= 1.0:
+            bucket["tokens"] -= 1.0
+            return True
+        return False
+
 
