+# ---------------------------------------------------------------------------
+# Failed login persistence (in-memory log)
+# ---------------------------------------------------------------------------
+# Stores a chronological record of failed login attempts so that callers can
+# audit or export them without touching the database schema.
+
+_FAILED_LOGIN_LOG: List[Dict[str, Any]] = []
+
+
+def log_failed_login(email: str) -> None:
+    """Append a failed login event to the in-memory log.
+
+    Args:
+        email: The email address that failed authentication.
+    """
+    _FAILED_LOGIN_LOG.append(
+        {"email": email, "attempted_at": datetime.now(timezone.utc).isoformat()}
+    )
+
+
+def get_failed_logins(email: Optional[str] = None) -> List[Dict[str, Any]]:
+    """Return recorded failed login events, optionally filtered by *email*."""
+    if email is None:
+        return list(_FAILED_LOGIN_LOG)
+    return [e for e in _FAILED_LOGIN_LOG if e["email"] == email]
+
