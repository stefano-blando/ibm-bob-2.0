+@bp.route("/<int:id>/like", methods=("POST",))
+@login_required
+def like(id):
+    """Toggle a like on a post for the current user."""
+    # Verify the post exists (no author check needed).
+    get_post(id, check_author=False)
+    db = get_db()
+    existing = db.execute(
+        "SELECT 1 FROM post_like WHERE user_id = ? AND post_id = ?",
+        (g.user["id"], id),
+    ).fetchone()
+    if existing is None:
+        db.execute(
+            "INSERT INTO post_like (user_id, post_id) VALUES (?, ?)",
+            (g.user["id"], id),
+        )
+    else:
+        db.execute(
+            "DELETE FROM post_like WHERE user_id = ? AND post_id = ?",
+            (g.user["id"], id),
+        )
+    db.commit()
+    return redirect(url_for("blog.index"))
+
+
