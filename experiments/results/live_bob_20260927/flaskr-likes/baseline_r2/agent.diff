diff --git a/tests/test_likes.py b/tests/test_likes.py
new file mode 100644
--- /dev/null
+++ b/tests/test_likes.py
+import pytest
+
+from flaskr.db import get_db
+
+
+def test_like_requires_login(client):
+    """Unauthenticated users are redirected to login when liking a post."""
+    response = client.post("/1/like")
+    assert response.headers["Location"] == "/auth/login"
+
+
+def test_like_nonexistent_post(client, auth):
+    """Liking a post that doesn't exist returns 404."""
+    auth.login()
+    response = client.post("/2/like")
+    assert response.status_code == 404
+
+
+def test_like_records_in_database(client, auth, app):
+    """A logged-in user can like a post; the like is stored in the database."""
+    auth.login()
+    response = client.post("/1/like")
+    assert response.headers["Location"] == "/"
+
+    with app.app_context():
+        db = get_db()
+        count = db.execute(
+            "SELECT COUNT(*) FROM post_like WHERE post_id = 1 AND user_id = 1"
+        ).fetchone()[0]
+        assert count == 1
+
+
+def test_like_is_idempotent(client, auth, app):
+    """Liking the same post twice does not create a duplicate record."""
+    auth.login()
+    client.post("/1/like")
+    client.post("/1/like")
+
+    with app.app_context():
+        db = get_db()
+        count = db.execute(
+            "SELECT COUNT(*) FROM post_like WHERE post_id = 1 AND user_id = 1"
+        ).fetchone()[0]
+        assert count == 1
+
+
+def test_index_shows_like_count(client, auth, app):
+    """The index page shows the number of likes next to each post."""
+    # Before any likes, count is 0
+    response = client.get("/")
+    assert b"0 likes" in response.data
+
+    # After one like, count is 1
+    auth.login()
+    client.post("/1/like")
+    response = client.get("/")
+    assert b"1 like" in response.data
