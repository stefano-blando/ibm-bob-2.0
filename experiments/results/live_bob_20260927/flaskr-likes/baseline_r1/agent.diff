+@bp.route("/<int:id>/like", methods=("POST",))
+@login_required
+def like(id):
+    """Like a post. Records one like per user per post."""
+    get_post(id, check_author=False)
+    db = get_db()
+    db.execute(
+        "INSERT OR IGNORE INTO post_like (post_id, user_id) VALUES (?, ?)",
+        (id, g.user["id"]),
+    )
+    db.commit()
+    return redirect(url_for("blog.index"))
