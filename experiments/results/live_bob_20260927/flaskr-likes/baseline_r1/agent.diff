diff --git a/tests/test_like.py b/tests/test_like.py
new file mode 100644
--- /dev/null
+++ b/tests/test_like.py
+"""Tests for the post like feature.
+
+NOTE: The post_like table must be present in the schema (schema.sql).
+Required DDL:
+    CREATE TABLE post_like (
+      post_id INTEGER NOT NULL,
+      user_id INTEGER NOT NULL,
+      PRIMARY KEY (post_id, user_id),
+      FOREIGN KEY (post_id) REFERENCES post (id),
+      FOREIGN KEY (user_id) REFERENCES user (id)
+    );
+"""
+import pytest
+
+from flaskr.db import get_db
+
+
+@pytest.fixture(autouse=True)
+def create_like_table(app):
+    """Create the post_like table for tests (mirrors required schema change)."""
+    with app.app_context():
+        get_db().executescript(
+            "CREATE TABLE IF NOT EXISTS post_like ("
+            "  post_id INTEGER NOT NULL,"
+            "  user_id INTEGER NOT NULL,"
+            "  PRIMARY KEY (post_id, user_id),"
+            "  FOREIGN KEY (post_id) REFERENCES post (id),"
+            "  FOREIGN KEY (user_id) REFERENCES user (id)"
+            ");"
+        )
+
+
+def test_like_requires_login(client):
+    response = client.post("/1/like")
+    assert response.headers["Location"] == "/auth/login"
+
+
+def test_like_post(client, auth, app):
+    auth.login()
+    response = client.post("/1/like")
+    assert response.headers["Location"] == "/"
+
+    with app.app_context():
+        count = get_db().execute(
+            "SELECT COUNT(*) FROM post_like WHERE post_id = 1"
+        ).fetchone()[0]
+        assert count == 1
+
+
+def test_like_is_idempotent(client, auth, app):
+    """Liking the same post twice should only record one like."""
+    auth.login()
+    client.post("/1/like")
+    client.post("/1/like")
+
+    with app.app_context():
+        count = get_db().execute(
+            "SELECT COUNT(*) FROM post_like WHERE post_id = 1"
+        ).fetchone()[0]
+        assert count == 1
+
+
+def test_like_nonexistent_post(client, auth):
+    auth.login()
+    response = client.post("/2/like")
+    assert response.status_code == 404
+
+
+def test_index_shows_like_count(client, auth, app):
+    with app.app_context():
+        get_db().execute(
+            "INSERT INTO post_like (post_id, user_id) VALUES (1, 1)"
+        )
+        get_db().commit()
+
+    auth.login()
+    response = client.get("/")
+    assert b"1 like" in response.data
+
+
+def test_index_shows_like_button_when_logged_in(client, auth):
+    auth.login()
+    response = client.get("/")
+    assert b'action="/1/like"' in response.data
+
+
+def test_index_no_like_button_when_logged_out(client):
+    response = client.get("/")
+    assert b'action="/1/like"' not in response.data
