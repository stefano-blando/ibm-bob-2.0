+@bp.route("/<int:id>/like", methods=("POST",))
+@login_required
+def like(id):
+    """Toggle a like on a post for the current user."""
+    db = get_db()
+    # Verify the post exists (borrows get_post without author check)
+    get_post(id, check_author=False)
+    existing = db.execute(
+        "SELECT 1 FROM post_like WHERE user_id = ? AND post_id = ?",
+        (g.user["id"], id),
+    ).fetchone()
+    if existing is None:
+        db.execute(
+            "INSERT INTO post_like (user_id, post_id) VALUES (?, ?)",
+            (g.user["id"], id),
+        )
+        db.commit()
+    return redirect(url_for("blog.index"))
+
+
