index ab96e71..4b1c09e 100644
--- a/flaskr/__init__.py
+++ b/flaskr/__init__.py
@@ -1,6 +1,16 @@
 import os
 
 from flask import Flask
+from markupsafe import Markup
+from markdown_it import MarkdownIt
+
+
+_md = MarkdownIt().disable("html_block").disable("html_inline")
+
+
+def _render_markdown(text):
+    """Render *text* as Markdown; raw HTML is escaped, not passed through."""
+    return Markup(_md.render(text))
 
 
 def create_app(test_config=None):
@@ -32,6 +42,8 @@ def create_app(test_config=None):
 
     db.init_app(app)
 
+    app.jinja_env.filters["markdown"] = _render_markdown
+
     # apply the blueprints to the app
     from . import auth
     from . import blog
